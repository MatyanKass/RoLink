{
  "name": "rolink-publisher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server that publishes audio, images and places to Roblox via Open Cloud and talks to RoLink over /rpc",
  "main": "dist/index.js",
  "bin": {
    "rolink-publish": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "start": "node dist/index.js",
    "test": "tsc -p . && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
