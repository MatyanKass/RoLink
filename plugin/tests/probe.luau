local roblox = require("@lune/roblox")
local game = roblox.Instance.new("DataModel")
local ws = game:GetService("Workspace")
local p = roblox.Instance.new("Part")
print(p.Size, p.Anchored, p.TopSurface, p.Color)
local cf = roblox.CFrame.fromOrientation(0.1, 0.2, 0.3)
print(cf:ToOrientation())
local m = roblox.Instance.new("Model")
p.Parent = m
print(pcall(function() m.WorldPivot = cf end))
print(pcall(function() m.PrimaryPart = p end))
print(pcall(function() return m:GetPivot() end))
print(pcall(function() p:AddTag("x"); return p:GetTags() end))
print(pcall(function() return roblox.Font.fromName("GothamSSm") end))
print(pcall(function() return roblox.Enum.Material.Metal, roblox.Enum.Material:GetEnumItems()[1] end))
print(pcall(function() return game:GetService("Selection") end))
print(typeof(cf), typeof(roblox.Enum.Material.Metal))
for k in roblox do io.write(k, " ") end print()
