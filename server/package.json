{
  "name": "rolink-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RoLink: MCP server + live bridge to Roblox Studio",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "typecheck": "tsc -p . --noEmit",
    "serve": "node dist/index.js --daemon",
    "test": "node test/e2e.mjs",
    "plugin:build": "node ../plugin/build.mjs",
    "plugin:install": "node ../plugin/build.mjs --install",
    "test:plugin": "node test/run-plugin-tests.mjs",
    "test:unit": "node --test test/meshimport.test.mjs test/mirror.test.mjs test/mirror.session.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "chokidar": "^5.0.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.9.3"
  }
}
